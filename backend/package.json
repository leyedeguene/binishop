{
  "name": "binishop-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "medusa develop",
    "start": "medusa start",
    "build": "medusa build",
    "migrations:run": "medusa db:migrate",
    "migrations:sync": "medusa db:sync-links",
    "seed": "medusa exec ./src/scripts/seed.ts",
    "user:create": "medusa user --email admin@binishop.com --password Admin123456!",
    "setup": "medusa db:migrate && medusa db:sync-links && medusa exec ./src/scripts/seed.ts && medusa user --email admin@binishop.com --password Admin123456!"
  },
  "dependencies": {
    "@medusajs/cli": "^2.19.0",
    "@medusajs/file": "^2.19.0",
    "@medusajs/file-local": "^2.19.0",
    "@medusajs/file-s3": "^2.19.0",
    "@medusajs/framework": "^2.19.0",
    "@medusajs/medusa": "^2.19.0",
    "@medusajs/payment-stripe": "^2.19.0",
    "dotenv": "^16.4.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^26.2.0",
    "jest": "^29.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
