# BINISHOP — BACKEND ENVIRONMENT
# Ce fichier est utilisé par Medusa.js
# lorsqu'il est exécuté directement (hors Docker)

# --- Database ---
DATABASE_URL=postgres://binishop:binishop_local_dev_2026@localhost:5432/binishop
DATABASE_TYPE=postgres

# --- Redis ---
REDIS_URL=redis://default:binishop_redis_dev_2026@localhost:6379

# --- MinIO ---
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=binishop_admin
MINIO_SECRET_KEY=binishop_minio_secret_key_2026
MINIO_BUCKET=binishop-media
MINIO_REGION=eu-west-1
MINIO_USE_SSL=false

# --- Medusa ---
PORT=9000
NODE_ENV=development
JWT_SECRET=binishop_jwt_secret_dev_2026_super_secret
COOKIE_SECRET=binishop_cookie_secret_dev_2026

# --- Admin ---
ADMIN_EMAIL=admin@binishop.com
ADMIN_PASSWORD=Admin123456!

# --- CORS ---
STORE_CORS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://localhost:8080
ADMIN_CORS=http://localhost:8000,http://localhost:3000,http://localhost:5173,http://localhost:8080